# Neon Postgres (pooled — runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?channel_binding=require&sslmode=require&pgbouncer=true&connect_timeout=15"

# Neon direct — for Prisma migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="<32-byte base64>"
AUTH_TRUST_HOST=true
