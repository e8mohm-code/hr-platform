// Prisma schema — منصة الموارد البشرية
// مشاركة بيانات بين المنشآت ممنوعة: كل صف فيه establishmentId

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production: Neon Postgres.
  // DATABASE_URL  = pooled connection (used at runtime, via PgBouncer)
  // DIRECT_URL    = unpooled connection (used by Prisma migrations)
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===================================================================
// Auth (NextAuth v5 PrismaAdapter)
// ===================================================================

model User {
  id              String   @id @default(cuid())
  name            String?
  email           String   @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  role            String   @default("MEMBER") // OWNER | MANAGER | MEMBER

  // Multi-tenancy
  establishmentId String?
  establishment   Establishment? @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  accounts        Account[]
  sessions        Session[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([establishmentId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ===================================================================
// Core domain
// ===================================================================

model Establishment {
  id            String  @id @default(cuid())
  name          String
  unifiedNumber String? // الرقم الموحد
  ownerEmail    String  @unique

  // Settings stored as JSON-encoded string (sqlite-friendly)
  customEmployeeFields    String?  // JSON array of {key,label,type,options?,required?}
  vacationEntitlementDays Int      @default(30)

  users         User[]
  branches      Branch[]
  brandList     Brand[]
  registrations Registration[]
  licenses      License[]
  employees     Employee[]
  activityLog   ActivityLog[]
  attendance    Attendance[]
  reminders     Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// New: Brand entity with logo
model Brand {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  name      String
  logoUrl   String?
  color     String?      // optional accent color for the brand

  branches  Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([establishmentId])
}

model Branch {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  name        String
  brand       String?       // legacy free-text label (kept for back-compat)
  brandRefId  String?
  brandRef    Brand?        @relation(fields: [brandRefId], references: [id], onDelete: SetNull)
  city        String
  address     String?
  managerName String?
  phone       String?

  licenses  License[]
  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([establishmentId])
  @@index([brandRefId])
}

model Registration {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  type        String
  number      String
  issueDate   DateTime?
  expiryDate  DateTime
  attachments String?           // JSON array of {url,name,uploadedAt}
  archived    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([establishmentId])
  @@index([expiryDate])
}

model License {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  type        String
  authority   String?
  number      String
  issueDate   DateTime?
  expiryDate  DateTime
  attachments String?           // JSON array of {url,name,uploadedAt}
  archived    Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([establishmentId])
  @@index([branchId])
  @@index([expiryDate])
}

model Employee {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Personal
  fullName    String
  gender      String?
  nationality String?
  dob         DateTime?
  phone       String?
  email       String?

  // IDs / docs
  employeeNo        String?
  iqamaNumber       String?
  iqamaExpiry       DateTime?
  sponsorNumber     String?
  healthCardNumber  String?
  healthCardExpiry  DateTime?
  lastVisaNumber    String?
  lastVisaExpiry    DateTime?

  // Employment
  jobTitle      String?
  department    String?
  joinDate      DateTime?
  contractStart DateTime?
  contractEnd   DateTime?
  contractType  String?

  // Compensation
  basicSalary       Decimal?
  housingAllowance  Decimal?
  commissions       Decimal?
  otherAllowances   Decimal?
  paymentMethod     String?
  iban              String?

  // GOSI
  gosiSubscriptionNo String?
  gosiSubjectWage    Decimal?
  // Status & extras
  status        String   @default("ACTIVE") // ACTIVE | RESIGNED | FINAL_EXIT
  customFields  String?  // JSON-encoded

  // Profile photo URL (also stored as a doc with type=PROFILE for history)
  photoUrl      String?

  activityLog   ActivityLog[]
  attendance    Attendance[]
  documents     EmployeeDocument[]
  reminders     Reminder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([establishmentId])
  @@index([branchId])
  @@index([iqamaExpiry])
  @@index([healthCardExpiry])
  @@index([contractEnd])
}

model ActivityLog {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  ts          DateTime @default(now())
  channel     String   @default("system")
  actionType  String?
  target      String?
  subject     String
  body        String?
  status      String   @default("success")
  payload     String?  // JSON-encoded
  attachments String?  // JSON-encoded

  @@index([establishmentId])
  @@index([employeeId])
  @@index([ts])
}

model EmployeeDocument {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type        String   // PROFILE | IQAMA | PASSPORT | CONTRACT | HEALTH_CARD | OTHER
  url         String
  fileName    String?
  uploadedAt  DateTime @default(now())

  @@index([employeeId])
  @@index([type])
}

model Reminder {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  employeeId  String?
  employee    Employee?  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  title       String
  body        String?
  dueDate     DateTime?
  completed   Boolean    @default(false)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([establishmentId])
  @@index([employeeId])
  @@index([dueDate])
}

model Attendance {
  id              String        @id @default(cuid())
  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date     DateTime
  status   String  // present | late | absent | vacation
  checkIn  DateTime?
  checkOut DateTime?
  notes    String?

  @@unique([employeeId, date])
  @@index([establishmentId])
  @@index([date])
}
